{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ROS2: Attach",
      "type": "ros2",
      "request": "attach"
    },

    {
      "name": "(gdb) Launch",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/onboard/src/imu/ros2_ws/src/build/inertial_sense_ros2/inertial_sense_ros2_node",
      "args": [],
      "stopAtEntry": true,
      "cwd": "${fileDirname}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "description": "Set Disassembly Flavor to Intel",
          "text": "-gdb-set disassembly-flavor intel",
          "ignoreFailures": true
        }
      ]
    },
    {
      "name": "C/C++ Runner: Debug Session",
      "type": "cppdbg",
      "request": "launch",
      "args": [],
      "stopAtEntry": false,
      "externalConsole": false,
      "cwd": "/home/vscode/sys-arch-2026/onboard/src/imu/ros2_ws/src/inertial-sense-sdk/ROS/ros2/src",
      "program": "/home/vscode/sys-arch-2026/onboard/src/imu/ros2_ws/src/inertial-sense-sdk/ROS/ros2/src/build/Debug/outDebug",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}